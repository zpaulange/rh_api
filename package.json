{
  "name": "sikarh-backend",
  "private": true,
  "version": "1.0.0",
  "description": "API SikaRH — Node.js, Express, TypeScript, Sequelize, MySQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/serveur.ts",
    "start": "node dist/serveur.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/scripts/test-api.ts",
    "db:creer": "tsx src/scripts/creer-base.ts",
    "migration:generer": "tsx src/scripts/generer.ts migration",
    "db:migrer": "tsx src/scripts/migrer.ts appliquer",
    "db:migrer:annuler": "tsx src/scripts/migrer.ts annuler",
    "db:migrer:statut": "tsx src/scripts/migrer.ts statut",
    "seeder:generer": "tsx src/scripts/generer.ts seeder",
    "db:seed": "tsx src/scripts/seed.ts appliquer",
    "db:seed:annuler": "tsx src/scripts/seed.ts annuler",
    "db:seed:statut": "tsx src/scripts/seed.ts statut",
    "db:initialiser": "tsx src/scripts/initialiser.ts",
    "db:creer:prod": "node dist/creer-base.js",
    "db:migrer:prod": "node dist/migrer.js appliquer",
    "db:initialiser:prod": "node dist/initialiser.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3"
  }
}

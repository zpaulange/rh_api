# Serveur
PORT=4000
NODE_ENV=development
# Origine du frontend autorisée (CORS) ; en production, servir le frontend et l'API sur la même origine
CORS_ORIGINE=http://localhost:5173

# Base MySQL
DB_HOTE=127.0.0.1
DB_PORT=3307
DB_NOM=sikarh
DB_UTILISATEUR=sikarh
DB_MOT_DE_PASSE=sikarh_dev

# Sécurité : secret de signature des sessions (au moins 32 caractères aléatoires en production)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire-de-64-caracteres
# Durée d'une session « Se souvenir de moi » (jours) ; sinon la session expire après inactivité
SESSION_PERSISTANTE_JOURS=30
# Échecs de connexion tolérés par adresse IP sur 15 minutes (30 recommandé en production)
LIMITE_ECHECS_CONNEXION=30
COOKIE_SECURISE=false

# Données de démonstration : autorise la réinitialisation depuis l'écran Paramètres (jamais en production)
DEMO=true
